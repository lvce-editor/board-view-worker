{
  "name": "@lvce-editor/board-view-worker-monorepo",
  "version": "0.0.0-dev",
  "description": "Board view worker monorepo for LVCE Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:extension": "node packages/build/src/build-extension.ts",
    "e2e": "npm run test:e2e --workspace=@lvce-editor/board-view-e2e",
    "e2e:headless": "npm run test:e2e:headless --workspace=@lvce-editor/board-view-e2e",
    "dev": "npm run build:extension && npm run dev --workspace=@lvce-editor/board-view-server",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b",
    "check:package": "cd dist && npm pack --dry-run",
    "build:static": "node packages/build/src/build-static.ts",
    "knip": "knip"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.17.0",
    "eslint": "10.15.0",
    "knip": "^6.48.0",
    "prettier": "^4.0.0-alpha.13",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "private": true
}
