{
  "id": "builtin.board-view",
  "name": "Boards",
  "icon": "media/chat.svg",
  "workerName": "Board View Worker",
  "description": "Independent boards for LVCE Editor",
  "repository": "https://github.com/lvce-editor/board-view-worker",
  "browser": "dist/boardWorkerMain.js",
  "contentSecurityPolicy": [
    "default-src 'none'",
    "script-src 'self'",
    "img-src data: https: http://127.0.0.1:* http://localhost:*",
    "connect-src https: wss: http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*"
  ],
  "isolated": true,
  "permissions": ["clipboard.write"],
  "categories": ["Other"],
  "configuration": {
    "chat2.connectedBoardIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Remembered Trello board IDs. API keys and tokens are never stored here."
    },
    "chat2.connectedBoardNames": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Last known names of remembered Trello boards."
    }
  },
  "activation": ["onCommand:chat2.showBoardLayout", "onView:chat2.views.board"],
  "rpc": [
    {
      "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
      "id": "builtin.board-view.description-markdown-worker",
      "name": "Board Description Markdown Worker",
      "type": "web-worker",
      "url": "dist/descriptionMarkdownWorkerMain.js"
    }
  ],
  "commands": [
    {
      "id": "chat2.showBoardLayout",
      "label": "View: Open Board Layout"
    }
  ],
  "views": [
    {
      "css": "media/board.css",
      "displayName": "Boards",
      "id": "chat2.views.board",
      "title": "Boards",
      "icon": "media/chat.svg",
      "kind": "virtualDom",
      "showSideBarHeader": false
    }
  ]
}
